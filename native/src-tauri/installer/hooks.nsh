; Jot's installer in Jot's colours and words. Tauri includes this before it builds the pages,
; so these settings reach the Modern UI. The pictures come from tools/installer-art.mjs.

!define MUI_BGCOLOR "F1ECE2"
!define MUI_TEXTCOLOR "1F1D1A"
!define MUI_HEADERIMAGE_RIGHT

!define MUI_WELCOMEPAGE_TITLE "Jot"
!define MUI_WELCOMEPAGE_TEXT "Plain notes that stay on this computer.$\r$\n$\r$\nNo account, no server, no tracking. Your notes are kept here and nowhere else.$\r$\n$\r$\nClick Next to install Jot."
!define MUI_FINISHPAGE_TITLE "Jot is ready"
!define MUI_FINISHPAGE_TEXT "Open Jot and press N to write your first note."
