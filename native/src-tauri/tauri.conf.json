{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jot",
  "version": "1.3.0",
  "identifier": "dev.mhfrough.jot",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Jot",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "visible": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Plain notes that stay on your device",
    "longDescription": "Jot is a plain notes app by mhfrough: no sign-in, no server, no tracking. Notes stay on your device, work offline, show when each one was created and last updated, and can be locked behind a password. Formatting, checklists, pins, search, archive and trash, export and import. https://mhfrough.github.io/jot/",
    "copyright": "© 2026 mhfrough (Mohammad Hamza). MIT licence.",
    "homepage": "https://mhfrough.github.io/jot/",
    "publisher": "mhfrough",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    },
    "linux": {
      "deb": {
        "section": "text"
      }
    },
    "license": "MIT"
  }
}
